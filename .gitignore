# Secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/

# The agent's working directories hold generated projects, plans and memory.
# Keep the directories themselves, not their contents.
# workspace/  = shared mode (WORKSPACE_MODE=shared); workspaces/ = one directory per conversation
workspace/*
!workspace/.gitkeep
workspaces/*
!workspaces/.gitkeep

# Saved conversations and eval results
.data/
evals/results/

# my scratch files (only at the project root; a bare "_*" would also hide new __init__.py files)
/_*
