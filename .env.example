LLM_PROVIDER=google_genai
MODEL_NAME=gemini-3.5-flash-lite

GOOGLE_API_KEY=your-google-api-key

# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# XAI_API_KEY=your-xai-key

WORKSPACE_DIR=./workspace
SANDBOX_IMAGE=python:3.12-slim
EXECUTION_TIMEOUT=60
TEST_TIMEOUT=180
ALLOW_UNSAFE_LOCAL_EXECUTION=false

# --- Optional settings (defaults shown) ---
# AGENT_MODE=pipeline          # pipeline = planner -> coder -> reviewer -> committer; react = single agent
# APPROVAL_MODE=dangerous      # dangerous = only write/run/install/git_commit need approval; all = every tool
# MAX_REVIEW_ROUNDS=3          # how often the reviewer may send work back to the coder
# BUILD_TIMEOUT=600            # docker build timeout (install_packages)
# RECURSION_LIMIT=150          # LangGraph step limit per run
# LLM_TEMPERATURE=             # leave unset unless your model supports it
# SANDBOX_USER=                # uid:gid inside the sandbox (default: your user, or 65534 if you run as root)
