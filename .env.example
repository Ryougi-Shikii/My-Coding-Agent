LLM_PROVIDER=google_genai
MODEL_NAME=gemini-2.0-flash

GOOGLE_API_KEY=your-google-api-key

# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# XAI_API_KEY=your-xai-key

WORKSPACE_DIR=./workspace
SANDBOX_IMAGE=python:3.12-slim
EXECUTION_TIMEOUT=60
TEST_TIMEOUT=180
ALLOW_UNSAFE_LOCAL_EXECUTION=false

# --- Optional settings (defaults shown) ---
# AGENT_MODE=auto              # auto = chat first, build when asked; pipeline = strict planner -> coder -> reviewer -> committer; react = single agent
# CONVERSATION_DB=             # saved conversations (default .data/conversations.sqlite; 'memory' = don't save)
# APPROVAL_MODE=dangerous      # dangerous = only write/run/install/git_commit need approval; all = every tool
# MAX_REVIEW_ROUNDS=3          # how often the reviewer may send work back to the coder
# BUILD_TIMEOUT=600            # docker build timeout (install_packages)
# RECURSION_LIMIT=150          # LangGraph step limit per run
# LLM_TEMPERATURE=             # leave unset unless your model supports it
# SANDBOX_USER=                # uid:gid inside the sandbox (default: your user, or 65534 if you run as root)
# SANDBOX_MEMORY=512m          # memory limit of the sandbox container (use 2g for media / ML work)
# SANDBOX_CPUS=1
# SANDBOX_PIDS=256
# SANDBOX_TMP_MB=128
# PACKAGE_ALLOWLIST=           # e.g. numpy,pandas,pillow  (empty or * = any package)
# ALLOW_SOURCE_BUILDS=false    # false = install_packages accepts wheels only (no setup.py runs)

# --- Workspaces ---
# WORKSPACE_MODE=session       # session = every conversation gets its own directory; shared = one WORKSPACE_DIR
# WORKSPACES_DIR=./workspaces  # where the per-conversation directories live (session mode)

# --- Context and cost ---
# RUN_TOKEN_BUDGET=300000      # tokens one user message may use in total (0 = unlimited); the run stops when reached
# CONTEXT_MAX_CHARS=100000     # cap on what is sent per model call (about 4 characters per token)
# CONTEXT_OLD_TOOL_CHARS=1200  # old tool results are shortened to this size
# CONTEXT_KEEP_RECENT=8        # this many newest messages keep their tool results in full
# CONTEXT_KEEP_IMAGES=2        # only this many recent images stay in context
# MAX_READ_CHARS=30000         # read_file limit (use start_line/end_line for more)
# MAX_IMAGE_BYTES=2000000      # largest image view_image accepts
